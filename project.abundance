              "ioValue": 500,
              "currentEquation": "500"
            }
          ],
          "topLevel": false,
          "allAtoms": [
            {
              "atomType": "Output",
              "x": 1,
              "y": 0.5,
              "uniqueID": "520cf263-de21-47f4-9481-d25d31d1790b",
              "ioValues": [
                {
                  "name": "number or geometry",
                  "ioValue": "__GEOMETRY_INPUT__"
                }
              ]
            },
            {
              "atomType": "Input",
              "x": 0,
              "y": 0.3,
              "uniqueID": "58976f81-9621-456a-b2fb-09379af910e9",
              "name": "Spacing",
