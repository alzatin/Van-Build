        {
          "atomType": "GitHubMolecule",
          "x": 0.3,
          "y": 0.3,
          "uniqueID": "8bd6f639-57b3-46c7-aaf3-b3661ee179a7",
          "name": "Sine-Wave-Approximation",
          "ioValues": [
            {
              "name": "Thickness",
              "ioValue": 180,
              "currentEquation": "180"
            },
            {
              "name": "Number of Bumps",
              "ioValue": 5,
              "currentEquation": "5"
            },
